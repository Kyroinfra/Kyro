# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL connection
# Format: postgresql://user:password@host:port/database
# Update these values to match your PostgreSQL instance
DATABASE_URL=postgresql://kyro:secret@localhost:5432/kyro

# JWT secret for authentication (Phase 1+)
# Generate a secure random string for production
JWT_SECRET=your-secret-key-here-change-in-production

# Redis configuration (Phase 2+)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# File uploads directory (optional)
# UPLOAD_DIR=./uploads
