# App
JWT_SECRET=

# Compose sets NODE_ENV, PORT and DATABASE_URL per service itself —
# DATABASE_URL is assembled from the POSTGRES_* values below. Only bare-host
# runs (pnpm dev outside docker) need to set them; uncomment as needed:
# NODE_ENV=development
# PORT=3000
# DATABASE_URL=postgresql://kyro:postgres_kyro@localhost:5432/kyro

# Upload storage root — the compose stack mounts a dedicated volume at these
# paths, so this only matters for bare-host runs (default: ./uploads):
# UPLOAD_DIR=/app/uploads

# Off by default: open registration bootstraps the first org only. After
# setup, members join via the owner's POST /org/members invite. Flip this
# to make /auth/register work on any already-configured instance.
# ALLOW_SIGNUP=true

# Storage safety cap in bytes, deployment-wide (default 10 GiB).
# Disk-safety net for uploads — not a billing quota. Raise if you have the space.
# STORAGE_LIMIT=10737418240

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Ollama — in the dev stack, an `ollama` service reuses your host's model
# store read-only and serves it at http://ollama:11434 (default OLLAMA_URL).
# OLLAMA_MODELS_DIR must point at the host directory containing `models/`:
#   - system-service install (default): /usr/share/ollama/.ollama/models
#   - user install:                     ~/.ollama/models (absolute path)
# To bypass the container and call a separate Ollama instance instead, set
# OLLAMA_URL — that instance must listen on a non-loopback interface
# (e.g. OLLAMA_HOST=0.0.0.0), which loopback-only installs do not by default.
OLLAMA_URL=
OLLAMA_MODELS_DIR=/usr/share/ollama/.ollama/models
EMBEDDING_MODEL=nomic-embed-text
# Vector dimension — must match EMBEDDING_MODEL (the file_chunks.embedding
# column is created with this width, #34). Switching models means: update both
# values, generate a migration for the new column type, and re-embed every
# file via POST /files/:id/reprocess (old chunks are incompatible).
EMBEDDING_DIM=768
CHAT_MODEL=llama3.2

# Hybrid-search dial: max cosine distance for a chunk to enter the vector arm
# of RRF — lower means stricter semantic recall. Default 0.5:
# VECTOR_DISTANCE_THRESHOLD=0.5

# Cross-encoder reranking (second relevance pass over retrieval results).
# Each reranked query makes up to 50 extra Ollama generate calls, so it is
# OFF by default (#35): set RERANK_ENABLED=true to turn it on. Scoring model
# defaults to llama3.2.
# RERANK_ENABLED=true
# RERANK_MODEL=llama3.2

# The better the model, the better the answer
# CHAT_MODEL=qwen2.5:7b
