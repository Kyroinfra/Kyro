FROM node:24-alpine
WORKDIR /app

# Pin pnpm to the version that produced pnpm-lock.yaml (host: pnpm -v).
# pnpm 11 needs node:sqlite → Node >= 22.5; the image is Node 24 LTS for that.
RUN npm install -g pnpm@11.28.4

# Install dependencies keyed to manifests only, so source changes never
# invalidate this layer (the old `COPY . .` → install order re-downloaded
# the whole dependency tree on every rebuild).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json packages/api/
COPY packages/web/package.json packages/web/
COPY packages/shared/package.json packages/shared/
RUN CI=true pnpm install --frozen-lockfile

# Sources last. Compose bind-mounts over packages/*/src at runtime —
# this copy exists so the pnpm workspace layout is complete inside the image.
COPY . .

# PUBLIC_API_URL intentionally unset: the browser talks to the API
# same-origin through the SvelteKit catch-all proxy (/api) since cors
# was removed (#29). Server-side calls use INTERNAL_API_URL.
WORKDIR /app/packages/web
EXPOSE 3001
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "3001"]
